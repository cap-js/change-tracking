{
  "name": "bookshop-mtx",
  "dependencies": {
    "@cap-js/change-tracking": "file:../../.",
    "@cap-js/hana": ">=2",
    "@sap/cds-mtxs": ">=3",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": ">=2",
    "@sap/cds-dk": ">=9",
    "better-sqlite3": ">=12"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "sqlite": {
      "driver": "better-sqlite3"
    },
    "requires": {
      "[production]": {
        "multitenancy": true,
        "extensibility": true,
        "auth": "xsuaa"
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "toggles": true,
      "extensibility": true
    },
    "features": {
      "serve_on_root": true
    },
    "profile": "with-mtx-sidecar"
  }
}
